      "description": "An ordinary named field, with hover, invalid, disabled and focus treatments.",
      "html": "<label class=\"ds-field\">作品名称<input class=\"ds-input\" value=\"陶瓷杯\" /></label>",
      "css": ".ds-field{font-family:var(--dsw-font-sans,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:550;color:var(--db-text,#20252e)}.ds-input{font-family:var(--dsw-font-sans,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);background:var(--db-surface,#fff);border:1px solid var(--db-input-border,#8492a5);border-radius:6px;color:inherit;font-size:14px;font-weight:400;min-height:38px;padding:7px 10px;width:100%}.ds-input:hover{border-color:var(--db-muted,#58677c)}.ds-input:focus-visible{outline:2px solid var(--db-accent,#295bc8);outline-offset:3px;}.ds-input[aria-invalid=true]{border-color:var(--db-bad,#b0303c)}.ds-input:disabled{opacity:.55;background:var(--db-fill,#edf1f7);cursor:not-allowed}@media(pointer:coarse){.ds-input{min-height:44px}}"
    },
    {
      "name": "Task Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Underline destinations with a secondary versions/QA group.",
      "html": "<nav class=\"ds-nav\" aria-label=\"工作导航\"><div class=\"ds-journey\"><button class=\"ds-nav-item\">需求</button><button class=\"ds-nav-item\" aria-current=\"page\">结果</button><button class=\"ds-nav-item\">调整</button><button class=\"ds-nav-item\">导出</button></div><div class=\"ds-secondary\"><button class=\"ds-nav-item\">版本</button><button class=\"ds-nav-item\">QA</button></div></nav>",
      "css": ".ds-nav{font-family:var(--dsw-font-sans,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:flex;gap:24px;align-items:center;justify-content:space-between;overflow:auto;background:var(--db-surface,#fff);border-bottom:1px solid var(--db-border,#d8dee8);padding:0 24px}.ds-journey,.ds-secondary{display:flex;gap:4px}.ds-nav-item{font-family:var(--dsw-font-sans,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);background:transparent;border:0;border-bottom:2px solid transparent;border-radius:0;color:var(--db-subtle,#47566a);cursor:pointer;min-height:46px;padding:10px 18px;font-size:13px;white-space:nowrap}.ds-secondary .ds-nav-item{color:var(--db-muted,#58677c);font-size:12px;padding:10px}.ds-nav-item:hover{background:var(--db-fill,#edf1f7);color:var(--db-text,#20252e)}.ds-nav-item[aria-current=page]{background:transparent;border-color:var(--db-accent,#295bc8);color:var(--db-accent,#295bc8);font-weight:650}.ds-nav-item:focus-visible{outline:2px solid var(--db-accent,#295bc8);outline-offset:3px;}.ds-nav-item:disabled{opacity:.42;cursor:not-allowed}@media(max-width:760px){.ds-nav{gap:8px;padding-inline:16px}.ds-nav-item{padding:9px 12px;min-height:42px}}@media(pointer:coarse){.ds-nav-item{min-height:44px}}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "status-badge",
      "description": "A semantic outlined status, not an interactive destination.",
      "html": "<span class=\"ds-badge\" data-tone=\"warn\">有未保存的修改</span>",
      "css": ".ds-badge{font-family:var(--dsw-font-sans,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:inline-flex;align-items:center;border-radius:5px;font-size:11px;line-height:18px;padding:2px 7px;border:1px solid var(--db-border,#d8dee8);color:var(--db-subtle,#47566a);white-space:nowrap}.ds-badge[data-tone=warn]{color:var(--db-warn,#946109);border-color:currentColor}.ds-badge[data-tone=ok]{color:var(--db-good,#23704e);border-color:currentColor}.ds-badge[data-tone=bad]{color:var(--db-bad,#b0303c);border-color:currentColor}"
    },
    {
      "name": "Standalone Card",
      "kind": "card",
      "refersTo": "card",
      "description": "A flat bordered container; contextual sections use the divider variant.",
      "html": "<section class=\"ds-card\"><h4 class=\"ds-card-title\">预览设置</h4><p class=\"ds-card-copy\">保存的结果保留来源版本。</p></section>",
      "css": ".ds-card{font-family:var(--dsw-font-sans,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);background:var(--db-surface,#fff);color:var(--db-text,#20252e);border:1px solid var(--db-border,#d8dee8);border-radius:8px;padding:16px 18px;box-shadow:none}.ds-card-title{margin:0 0 12px;font-size:14px;font-weight:650}.ds-card-copy{margin:8px 0 12px;font-size:14px;line-height:1.55}"
    },
    {
      "name": "Saved-Result Frame",
      "kind": "custom",
      "refersTo": "film-frame",
      "description": "The actual missing-preview variant of the source-bound filmstrip frame.",
      "html": "<button class=\"ds-frame\" aria-pressed=\"true\"><span class=\"ds-frame-empty\">暂无图像</span><span class=\"ds-frame-caption\"><span>r0002</span><span>当前</span></span></button>",
      "css": ".ds-frame{font-family:var(--dsw-font-sans,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:flex;flex-direction:column;width:110px;min-width:0;background:transparent;border:1px solid transparent;border-radius:5px;padding:4px;cursor:pointer;color:var(--db-muted,#58677c);text-align:left;transition:border-color 180ms ease-out,background-color 180ms ease-out}.ds-frame-empty{display:flex;align-items:center;justify-content:center;width:100%;aspect-ratio:4/3;border-radius:3px;background:var(--db-fill,#edf1f7);font-size:10px;text-align:center;padding:6px}.ds-frame-caption{display:flex;gap:4px;justify-content:space-between;font-size:11px;padding-top:5px;flex-wrap:wrap}.ds-frame:hover{background:var(--db-surface,#fff)}.ds-frame[aria-pressed=true]{border-color:var(--db-accent,#295bc8);color:var(--db-accent,#295bc8);background:var(--db-surface,#fff)}.ds-frame:focus-visible{outline:2px solid var(--db-accent,#295bc8);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-frame{transition:none}}"
    },
    {
      "name": "Tool Disclosure",
      "kind": "custom",
      "refersTo": "disclosure",
      "description": "Native in-place disclosure; application code supplies scoped persistent state.",
      "html": "<details class=\"ds-disclosure\"><summary class=\"ds-summary\">摄影设置</summary><p class=\"ds-disclosure-copy\">相机与来源版本</p></details>",
      "css": ".ds-disclosure{font-family:var(--dsw-font-sans,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);border-top:1px solid var(--db-border,#d8dee8);padding-top:8px;margin-top:16px;color:var(--db-text,#20252e);font-size:14px;line-height:1.55}.ds-summary{cursor:pointer;min-height:34px;padding:6px 0;font-weight:550;color:var(--db-subtle,#47566a)}.ds-disclosure[open]>.ds-summary{margin-bottom:8px;color:var(--db-text,#20252e)}.ds-summary:focus-visible{outline:2px solid var(--db-accent,#295bc8);outline-offset:3px;}.ds-disclosure-copy{font-size:12px;color:var(--db-muted,#58677c)}@media(pointer:coarse){.ds-summary{min-height:44px}}"
    },
    {
      "name": "Text Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Borderless compact action used within tools.",
      "html": "<button class=\"ds-chip\">查看详情</button>",
      "css": ".ds-chip{font-family:var(--dsw-font-sans,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:inline-flex;align-items:center;gap:6px;background:transparent;border:0;border-radius:7px;color:var(--db-subtle,#47566a);cursor:pointer;font-size:12px;padding:6px 8px}.ds-chip:hover{background:var(--db-fill,#edf1f7);color:var(--db-text,#20252e)}.ds-chip:focus-visible{outline:2px solid var(--db-accent,#295bc8);outline-offset:3px;}"
    }
  ],
  "narrative": {
    "northStar": "光台 / The Lighttable",
    "overview": "光台 places real work on a quiet studio surface. Cool neutral planes, graphite text and cobalt selection keep model imagery legible; the existing orange DeepBlend mark remains a small identity asset rather than becoming the interface accent.\n\nThis is an operational workbench with compact controls and readable source captions. Borders, tonal mats and restrained rounding provide order. System, light and dark preferences remain authoritative, and the same composition responds to the available app or embedded-panel width.",
    "keyCharacteristics": [
      "Real imagery and visible source identity.",
      "Flat planes with precise cobalt selection.",
      "Compact system typography and tabular numerals.",
      "Contextual controls with persistent disclosure."
    ],
    "rules": [
      {
        "name": "The Source-Bound Frame Rule",
        "body": "Keep the selected image, saved revision caption and valid actions bound to the same result; distinguish the selected revision from the current revision.",
        "section": "colors"
      },
      {
        "name": "The Operational Type Rule",
        "body": "Use the system sans stack for controls and task headings; reserve the mono stack for technical values and code.",
        "section": "typography"
      },
      {
        "name": "The Flat Lighttable Rule",
        "body": "Keep the primary stage and contextual tool sections flat; use tonal fills, thin borders and explicit selection outlines to establish hierarchy.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the theme-specific accent for selection, focus and primary action.",
      "Do retain source captions, selected/current distinction and explicit empty or unsupported states.",
      "Do keep the current result contained within its mat and use cropped thumbnails only in the filmstrip.",
      "Do preserve keyboard focus, scoped disclosure state, reduced motion and larger coarse-pointer targets.",
      "Do keep creation controls reachable after choosing a recipe or blank start, while preserving per-recipe drafts.",
      "Do reveal the actual destination when following a creation guide or selecting a camera or light.",
      "Do keep save feedback visible and show the requested project as loading until its source is ready."
    ],
    "donts": [
      "Don't replace user-selected light, dark or system appearance with a fixed palette.",
      "Don't introduce decorative entrance choreography into the lighttable.",
      "Don't present an optional project goal as an executable model-generation endpoint.",
      "Don't detach download or export controls from their actual image, project and saved revision."
    ]
  }
}
