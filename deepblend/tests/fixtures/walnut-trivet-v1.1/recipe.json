{
  "schemaVersion": "deepblend.recipe/v1",
  "id": "deepblend.walnut-trivet",
  "version": "1.1.0",
  "title": "胡桃木格栅垫 · Walnut trivet",
  "description": "创建 240 毫米见方的格栅垫，设置横条间距并保持居中，再继续调整半搭接。 Create a 240 mm lattice trivet with centered cross-slat spacing and editable half laps.",
  "author": {
    "name": "DeepBlend contributors",
    "url": "https://github.com/pearjelly/deep-blend"
  },
  "license": "MIT",
  "source": {
    "url": "https://github.com/pearjelly/deep-blend"
  },
  "compatibility": {
    "sceneSchemaVersion": "deepblend.scene/v1",
    "capabilities": [
      "geometry.joinery.half_lap",
      "geometry.modifiers",
      "geometry.primitive",
      "geometry.procedural.mesh",
      "material.principled",
      "material.procedural",
      "recipe.geometry-bindings",
      "recipe.array-bindings"
    ]
  },
  "input": {
    "path": "scene-spec.json",
    "sha256": "005f2e6a19a535730b022ab1338de1034e60c0cfb1d13bb846602673f4033a61"
  },
  "preview": {
    "path": "preview.png",
    "sha256": "a949ddff4499e1156c35143b27cb055024ef1a11f58939fb035d2f0138ffba22",
    "mediaType": "image/png",
    "alt": "浅色石面上的胡桃木格栅垫，共七根相扣的木条。 Seven interlocking walnut slats on a light stone surface."
  },
  "parameters": [
    {
      "id": "wood-tone",
      "title": "木色 · Wood tone",
      "type": "color",
      "default": [
        0.125,
        0.046,
        0.019
      ],
      "bindings": [
        {
          "kind": "material",
          "materialId": "walnut-lengthwise",
          "property": "baseColor"
        },
        {
          "kind": "material",
          "materialId": "walnut-crosswise",
          "property": "baseColor"
        }
      ]
    },
    {
      "id": "surface-roughness",
      "title": "表面粗糙度 · Finish roughness",
      "type": "number",
      "default": 0.44,
      "minimum": 0.3,
      "maximum": 0.65,
      "bindings": [
        {
          "kind": "material",
          "materialId": "walnut-lengthwise",
          "property": "roughness"
        },
        {
          "kind": "material",
          "materialId": "walnut-crosswise",
          "property": "roughness"
        }
      ]
    },
    {
      "id": "slat-spacing",
      "title": "横条间距（mm） · Slat spacing (mm)",
      "type": "number",
      "default": 78,
      "minimum": 52,
      "maximum": 92,
      "bindings": [
        {
          "kind": "array",
          "entityId": "cross-slats",
          "modifierIndex": 0,
          "property": "offset",
          "axis": "x",
          "multiplier": 0.001
        },
        {
          "kind": "entity",
          "entityId": "cross-slats",
          "property": "location",
          "axis": "x",
          "multiplier": -0.001
        }
      ]
    }
  ]
}
