{
  "schemaVersion": "deepblend.recipe/v1",
  "id": "deepblend.glazed-cup",
  "version": "3.1.0",
  "title": "青釉带把手杯",
  "description": "用高度、杯口外径和壁厚三个毫米参数创建带把手陶瓷杯，杯身与把手连接同步调整；保留釉色、可继续编辑的几何、原生保存和细节预览。",
  "author": {
    "name": "DeepBlend contributors",
    "url": "https://github.com/pearjelly/deep-blend"
  },
  "license": "MIT",
  "source": {
    "url": "https://github.com/pearjelly/deep-blend",
    "note": "Original procedural handled cup with explicit 2.5 endpoint tension, retained body dimensions and analytic corner normals. Actual fixed hero-camera Blender preview and SceneSpec bytes are pinned. Historical v1 and v2 are preserved byte-for-byte in their fixtures; technical evidence is not artistic approval."
  },
  "compatibility": {
    "sceneSchemaVersion": "deepblend.scene/v1",
    "capabilities": [
      "geometry.handled_cup",
      "geometry.handled_cup.tension",
      "geometry.handled_cup.tension.extended",
      "geometry.primitive",
      "material.principled",
      "recipe.geometry-bindings",
      "recipe.generator-bindings"
    ]
  },
  "input": {
    "path": "scene-spec.json",
    "sha256": "ad9ae3509dc1cb9ebd01acc153f5d6724a7d2e7318d90858dedb55d2ca3cb09c"
  },
  "preview": {
    "path": "preview.png",
    "sha256": "b8f7b70e26032ef9f6deae577856a71342c450a0e71e47c804876227d1086807",
    "mediaType": "image/png",
    "alt": "青釉带把手杯默认参数的实际 Blender 主视角渲染"
  },
  "parameters": [
    {
      "id": "cup-height-mm",
      "title": "杯身高度（毫米）",
      "description": "杯身高度，联动把手上下连接位置与默认摄影构图。",
      "type": "number",
      "default": 105,
      "minimum": 95,
      "maximum": 130,
      "bindings": [
        {
          "kind": "generator",
          "entityId": "cup",
          "property": "height",
          "multiplier": 0.001
        },
        {
          "kind": "generator",
          "entityId": "cup",
          "property": "handleLower",
          "multiplier": 0.0002666666666666667
        },
        {
          "kind": "generator",
          "entityId": "cup",
          "property": "handleUpper",
          "multiplier": 0.0007428571428571429
        },
        {
          "kind": "camera",
          "cameraId": "hero",
          "property": "location",
          "axis": "x",
          "multiplier": 0.0014952380952380953
        },
        {
          "kind": "camera",
          "cameraId": "hero",
          "property": "location",
          "axis": "y",
          "multiplier": -0.002333333333333333
        },
        {
          "kind": "camera",
          "cameraId": "hero",
          "property": "location",
          "axis": "z",
          "multiplier": 0.0012857142857142859
        },
        {
          "kind": "camera",
          "cameraId": "hero",
          "property": "targetPoint",
          "axis": "z",
          "multiplier": 0.0005
        },
        {
          "kind": "camera",
          "cameraId": "roots",
          "property": "location",
          "axis": "x",
          "multiplier": 0.0008666666666666667
        },
        {
          "kind": "camera",
          "cameraId": "roots",
          "property": "location",
          "axis": "y",
          "multiplier": -0.0016666666666666666
        },
        {
          "kind": "camera",
          "cameraId": "roots",
          "property": "location",
          "axis": "z",
          "multiplier": 0.0009714285714285713
        },
        {
          "kind": "camera",
          "cameraId": "roots",
          "property": "targetPoint",
          "axis": "z",
          "multiplier": 0.0005238095238095238
        },
        {
          "kind": "camera",
          "cameraId": "inside",
          "property": "location",
          "axis": "x",
          "multiplier": 0.0013333333333333335
        },
        {
          "kind": "camera",
          "cameraId": "inside",
          "property": "location",
          "axis": "y",
          "multiplier": -0.0019047619047619048
        },
        {
          "kind": "camera",
          "cameraId": "inside",
          "property": "location",
          "axis": "z",
          "multiplier": 0.0030476190476190477
        },
        {
          "kind": "camera",
          "cameraId": "inside",
          "property": "targetPoint",
          "axis": "z",
          "multiplier": 0.0004761904761904762
        }
      ]
    },
    {
      "id": "cup-outer-diameter-mm",
      "title": "杯口外径（毫米）",
      "description": "杯口外径，联动把手截面、杯身连接尺寸与默认摄影中心。",
      "type": "number",
      "default": 80,
      "minimum": 72,
      "maximum": 96,
      "bindings": [
        {
          "kind": "generator",
          "entityId": "cup",
          "property": "radius",
          "multiplier": 0.0005
        },
        {
          "kind": "generator",
          "entityId": "cup",
          "property": "handleRadius",
          "multiplier": 6.875e-05
        },
        {
          "kind": "generator",
          "entityId": "cup",
          "property": "rootRadius",
          "multiplier": 0.00011250000000000001
        },
        {
          "kind": "generator",
          "entityId": "cup",
          "property": "rootLength",
          "multiplier": 7.5e-05
        },
        {
          "kind": "camera",
          "cameraId": "hero",
          "property": "location",
          "axis": "x",
          "multiplier": 0.000225
        },
        {
          "kind": "camera",
          "cameraId": "hero",
          "property": "targetPoint",
          "axis": "x",
          "multiplier": 0.000225
        },
        {
          "kind": "camera",
          "cameraId": "roots",
          "property": "location",
          "axis": "x",
          "multiplier": 0.0005499999999999999
        },
        {
          "kind": "camera",
          "cameraId": "roots",
          "property": "targetPoint",
          "axis": "x",
          "multiplier": 0.0005499999999999999
        }
      ]
    },
    {
      "id": "cup-wall-mm",
      "title": "杯壁厚度（毫米）",
      "description": "杯壁厚度，保留原底厚和圆角。",
      "type": "number",
      "default": 3,
      "minimum": 3,
      "maximum": 5,
      "bindings": [
        {
          "kind": "generator",
          "entityId": "cup",
          "property": "wallThickness",
          "multiplier": 0.001
        }
      ]
    },
    {
      "id": "main-color",
      "title": "陶瓷釉色",
      "description": "调整杯体与把手的统一釉色。",
      "type": "color",
      "default": [
        0.035,
        0.24,
        0.2
      ],
      "bindings": [
        {
          "kind": "material",
          "materialId": "glaze",
          "property": "baseColor"
        }
      ]
    },
    {
      "id": "surface-roughness",
      "title": "主表面粗糙度",
      "description": "调整陶瓷釉面的光泽；数值越小，表面越亮。",
      "type": "number",
      "default": 0.22,
      "minimum": 0.12,
      "maximum": 0.42,
      "bindings": [
        {
          "kind": "material",
          "materialId": "glaze",
          "property": "roughness"
        }
      ]
    },
    {
      "id": "exposure",
      "title": "摄影曝光",
      "description": "调整整体画面的明暗，预览和成品同步生效。",
      "type": "number",
      "default": 0,
      "minimum": -1,
      "maximum": 1,
      "bindings": [
        {
          "kind": "render-profile",
          "profile": "preview",
          "property": "exposure"
        },
        {
          "kind": "render-profile",
          "profile": "final",
          "property": "exposure"
        }
      ]
    }
  ]
}
