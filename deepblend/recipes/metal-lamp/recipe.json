{
  "schemaVersion": "deepblend.recipe/v1",
  "id": "deepblend.metal-lamp",
  "version": "2.2.0",
  "title": "香槟金属桌灯",
  "description": "连续旋压灯罩、沿曲面延伸的金属细纹、珐琅内衬、曲线弯臂与贴地线缆。分别调整旋压件和拉丝件的粗糙度，同步调整金属颜色与摄影曝光；灯罩外径联动金属壁与内衬，颈口保持，提供独立内衬检查相机。",
  "author": {
    "name": "DeepBlend contributors",
    "url": "https://github.com/pearjelly/deep-blend"
  },
  "license": "MIT",
  "source": {
    "url": "https://github.com/pearjelly/deep-blend",
    "note": "Native metal-lamp benchmark with UV grain. SceneSpec bytes and native hero pixels are pinned; preview metadata is removed. Hero geometry/materials/camera remain unchanged; paired-profile diameter control and liner inspection camera are added. Source URL is attribution, not an installation endpoint."
  },
  "compatibility": {
    "sceneSchemaVersion": "deepblend.scene/v1",
    "capabilities": [
      "animation.transform",
      "geometry.curve",
      "geometry.lathe",
      "geometry.modifiers",
      "geometry.primitive",
      "material.anisotropy",
      "material.principled",
      "material.procedural",
      "material.procedural.uv",
      "recipe.geometry-bindings",
      "recipe.lathe-shell-bindings",
      "recipe.curve-point-bindings",
      "recipe.threshold-bindings"
    ]
  },
  "input": {
    "path": "scene-spec.json",
    "sha256": "9170d39ad1d3b14e1e9332c10d0f0daf922c259407ea6ab545ef53e4b02f64f0"
  },
  "preview": {
    "path": "preview.png",
    "sha256": "a4c39a0679b5c829fa7183b55a5b637d3fcc0f6dfaf89e7dc0f2f319c9ed9572",
    "mediaType": "image/png",
    "alt": "香槟金属桌灯默认参数及曲面细纹的实际 Blender 渲染"
  },
  "parameters": [
