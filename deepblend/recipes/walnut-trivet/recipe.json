{
  "schemaVersion": "deepblend.recipe/v1",
  "id": "deepblend.walnut-trivet",
  "version": "1.2.0",
  "title": "胡桃木格栅垫 · Walnut trivet",
  "description": "创建240毫米见方的胡桃木格栅垫，设置居中的横条间距和0–1毫米边缘倒角；0保留锐边。 Create a 240 mm walnut trivet with centered slats and adjustable 0–1 mm edge bevels; 0 keeps sharp edges.",
  "author": {
    "name": "DeepBlend contributors",
    "url": "https://github.com/pearjelly/deep-blend"
  },
  "license": "MIT",
  "source": {
    "url": "https://github.com/pearjelly/deep-blend",
    "note": "Exact 1.1.0 source with explicit per-face UVs and 0.5 mm convex edge finishing. Preview is the actual default 720x540 / 24 sample Host render; only PNG metadata was removed. Native/source provenance: deepblend/docs/validation/timber-edge-preview-1121.json."
  },
  "compatibility": {
    "sceneSchemaVersion": "deepblend.scene/v1",
    "capabilities": [
      "geometry.joinery.half_lap",
      "geometry.modifiers",
      "geometry.primitive",
      "geometry.procedural.mesh",
      "material.principled",
      "material.procedural",
      "recipe.geometry-bindings",
      "recipe.array-bindings",
      "geometry.joinery.half_lap.edge_finish",
      "recipe.half-lap-bindings"
    ]
  },
  "input": {
    "path": "scene-spec.json",
    "sha256": "4290f5e49d52475f29e27bd62b8a81bc259bd5cb8156f152054664d7a4b8bfbd"
  },
  "preview": {
    "path": "preview.png",
    "sha256": "1bfadbc47279dca97795046d766aa4cc7b1d64700ab639865d137abefb00bf36",
    "mediaType": "image/png",
    "alt": "浅色石面上的胡桃木格栅垫，默认78毫米间距与0.5毫米倒角的实际Blender渲染。 Native Blender render of the walnut trivet at 78 mm spacing and 0.5 mm edge width."
  },
  "parameters": [
    {
      "id": "wood-tone",
      "title": "木色 · Wood tone",
      "type": "color",
      "default": [
        0.125,
        0.046,
        0.019
      ],
      "bindings": [
        {
          "kind": "material",
          "materialId": "walnut-lengthwise",
          "property": "baseColor"
        },
        {
          "kind": "material",
          "materialId": "walnut-crosswise",
          "property": "baseColor"
        }
      ]
    },
    {
      "id": "surface-roughness",
      "title": "表面粗糙度 · Finish roughness",
      "type": "number",
      "default": 0.44,
      "minimum": 0.3,
      "maximum": 0.65,
      "bindings": [
        {
          "kind": "material",
          "materialId": "walnut-lengthwise",
          "property": "roughness"
        },
        {
          "kind": "material",
          "materialId": "walnut-crosswise",
          "property": "roughness"
        }
      ]
    },
    {
      "id": "slat-spacing",
      "title": "横条间距（mm） · Slat spacing (mm)",
      "type": "number",
      "default": 78,
      "minimum": 52,
      "maximum": 92,
      "bindings": [
        {
          "kind": "array",
          "entityId": "cross-slats",
          "modifierIndex": 0,
          "property": "offset",
          "axis": "x",
          "multiplier": 0.001
        },
        {
          "kind": "entity",
          "entityId": "cross-slats",
          "property": "location",
          "axis": "x",
          "multiplier": -0.001
        }
      ]
    },
    {
      "id": "edge-width",
      "title": "边缘倒角（mm） · Edge width (mm)",
      "description": "0保留锐边。保存后可继续修改。 0 keeps sharp edges. Continue editing after saving.",
      "type": "number",
      "default": 0.5,
      "minimum": 0,
      "maximum": 1,
      "bindings": [
        {
          "kind": "half-lap",
          "entityIds": [
            "longitudinal-slats",
            "cross-slats"
          ],
          "property": "edgeWidth",
          "multiplier": 0.001
        }
      ]
    }
  ]
}
