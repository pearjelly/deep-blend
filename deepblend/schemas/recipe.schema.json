{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepblend.local/schemas/recipe.schema.json",
  "title": "DeepBlend portable product recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "description",
    "author",
    "license",
    "source",
    "compatibility",
    "input",
    "preview",
    "parameters"
  ],
  "properties": {
    "schemaVersion": {
      "const": "deepblend.recipe/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[a-zA-Z0-9.-]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneSchemaVersion",
        "capabilities"
      ],
      "properties": {
        "sceneSchemaVersion": {
          "const": "deepblend.scene/v1"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "items": {
            "enum": [
              "geometry.primitive",
              "geometry.primitive.dimensions",
              "geometry.lathe",
              "geometry.curve",
              "geometry.handled_cup",
              "geometry.handled_cup.tension",
              "geometry.handled_cup.tension.extended",
              "geometry.modifiers",
              "material.principled",
              "material.glass",
              "material.emission",
              "material.procedural",
              "material.procedural.uv",
              "material.anisotropy",
              "animation.transform",
              "animation.material",
              "recipe.geometry-bindings",
              "recipe.generator-bindings"
            ]
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "scene-spec.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "mediaType",
        "alt"
      ],
      "properties": {
        "path": {
          "const": "preview.png"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mediaType": {
          "const": "image/png"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/colorParameter"
          },
          {
            "$ref": "#/$defs/numberParameter"
          }
        ]
      }
    }
  },
  "$defs": {
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "materialId",
            "property"
          ],
          "properties": {
            "kind": {
              "const": "material"
            },
            "materialId": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$"
            },
            "property": {
              "enum": [
                "baseColor",
                "roughness"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "profile",
            "property"
          ],
          "properties": {
            "kind": {
              "const": "render-profile"
            },
            "profile": {
              "enum": [
                "preview",
                "final"
              ]
            },
            "property": {
              "const": "exposure"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entityId",
            "property",
            "axis",
            "multiplier"
          ],
          "description": "Apply a bounded parameter delta to an explicit local box dimension or entity location. No expressions or arbitrary paths.",
          "properties": {
            "kind": {
              "const": "entity"
            },
            "entityId": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$"
            },
            "property": {
              "enum": [
                "dimensions",
                "location"
              ]
            },
            "axis": {
              "enum": [
                "x",
                "y",
                "z"
              ]
            },
            "multiplier": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            },
            "offsetAnimation": {
              "type": "boolean",
              "description": "Explicitly translate keyframe values on the bound location axis by the same delta, preserving the motion. Only valid for location bindings."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cameraId",
            "property",
            "axis",
            "multiplier"
          ],
          "properties": {
            "kind": {
              "const": "camera"
            },
            "cameraId": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$"
            },
            "property": {
              "enum": [
                "location",
                "targetPoint"
              ]
            },
            "axis": {
              "enum": [
                "x",
                "y",
                "z"
              ]
            },
            "multiplier": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            }
          },
          "description": "Apply a bounded parameter delta to an explicit camera position or aim point; animated camera channels are refused."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entityId",
            "property",
            "multiplier"
          ],
          "properties": {
            "kind": {
              "const": "generator"
            },
            "entityId": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$"
            },
            "property": {
              "enum": [
                "height",
                "radius",
                "wallThickness",
                "handleLower",
                "handleUpper",
                "handleRadius",
                "rootRadius",
                "rootLength"
              ]
            },
            "multiplier": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            }
          },
          "description": "Apply a bounded scalar delta to an explicit handled_cup generator dimension, preserving unbound generator properties."
        }
      ]
    },
    "colorParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "default",
        "bindings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "type": {
          "const": "color"
        },
        "default": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "numberParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "default",
        "minimum",
        "maximum",
        "bindings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "type": {
          "const": "number"
        },
        "default": {
          "type": "number"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    }
  }
}
