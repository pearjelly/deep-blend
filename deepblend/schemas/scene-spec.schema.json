{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepblend.local/schemas/scene-spec.schema.json",
  "title": "DeepBlend SceneSpec v1",
  "description": "The structural source of truth for one DeepBlend scene (SPEC §8.1: 'SceneSpec 场景结构事实来源'). A .blend file is a compile artifact of this document, never the authority. Scenes are compiled from a SceneSpec and modified only through ScenePatch operations, so that every revision is diffable, replayable and auditable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "entities",
    "cameras",
    "renderProfiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "deepblend.scene/v1"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "armatures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/armature"
      },
      "description": "Armatures this scene declares (SPEC §20 M6, character animation). Each is one skeleton, created as its own object and named `<prefix><id>` like every other product object. Entities are skinned to an armature (`entity.armatureId`, with Blender's automatic weights) and animation tracks can drive a bone of it (`targetKind: \"bone\"` with `boneName`), so a rig both moves and moves its mesh."
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gravity": {
          "type": "number",
          "description": "Downward acceleration in m/s². Blender's own default (-9.81) applies when absent."
        },
        "bake": {
          "type": "boolean",
          "default": true,
          "description": "Whether the compile bakes the simulation into the checkpoint. Baking is what makes a render show the physics rather than the initial pose, and it is not instant — so a build that wants the SETUP without paying for the bake can say so."
        }
      },
      "description": "Scene-level physics settings. The bodies themselves are per-entity (`entity.rigidBody`), because which things move is a property of those things."
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/light"
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "animationTracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/animationTrack"
      }
    },
    "renderProfiles": {
      "$ref": "#/$defs/renderProfiles"
    },
    "world": {
      "$ref": "#/$defs/world"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "description": "The scene's environment illumination: what fills every gap the geometry does not cover. This is the BACKGROUND a viewer sees behind the product, and `color`/`strength` are exactly Blender's World Background node. Omitting the whole block is legal and means the values below, which used to be a constant buried in the compiler (`deepblend_scene.py`) and were therefore unreachable from a SceneSpec: a brief asking for a black background could be honoured only by accident, with a backdrop plane, and any camera that saw past that plane found the hidden grey. An explicit black background is `{\"color\": [0, 0, 0, 1], \"strength\": 0}`.",
      "properties": {
        "color": {
          "$ref": "#/$defs/unitColor",
          "default": [
            0.02,
            0.021,
            0.026,
            1
          ]
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "default": 0.6
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetId"
          ],
          "properties": {
            "assetId": {
              "$ref": "#/$defs/id"
            },
            "rotation": {
              "type": "number",
              "description": "Rotation around world Z in radians; default zero."
            }
          }
        }
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "unitColor": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "Linear RGB (3) or RGBA (4). Values are scene-linear, not sRGB display values."
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "fps",
        "frameStart",
        "frameEnd",
        "aspectRatio"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "goal": {
          "type": "string",
          "maxLength": 2000,
          "description": "The operator's natural-language brief. Retained verbatim for audit; it never affects compilation."
        },
        "units": {
          "type": "string",
          "enum": [
            "metric",
            "imperial"
          ],
          "default": "metric"
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "frameStart": {
          "type": "integer",
          "minimum": 0
        },
        "frameEnd": {
          "type": "integer",
          "minimum": 1
        },
        "aspectRatio": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$",
          "description": "Informational for M1. Resolution is owned by the render profiles."
        },
        "activeCamera": {
          "type": "string",
          "description": "Camera id the animation is seen through. The active-camera view of a view plan renders this one; when absent the first declared camera is used."
        },
        "referenceImages": {
          "$ref": "#/$defs/referenceImages"
        },
        "reviewSubjectId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 200
        },
        "commercialUse": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "path"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "glb",
            "gltf",
            "fbx",
            "obj",
            "usd",
            "blend",
            "png",
            "jpg",
            "jpeg",
            "hdr",
            "exr"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative POSIX path. Absolute paths and any '..' segment are rejected by the path guard (SPEC §15.2)."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license": {
          "$ref": "#/$defs/license"
        }
      }
    },
    "proceduralTexture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "scale"
      ],
      "description": "A procedural surface texture. A material with only scalar parameters renders as one flat colour, which is what makes paper, wood and glazed ceramic all read as plastic; this block adds the surface relief and variation that distinguishes them. It is built as a real node graph (texture coordinate -> mapping -> pattern -> bump / roughness / base colour), not a baked image, so it needs no asset ingest and stays resolution-independent.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "noise",
            "wave",
            "voronoi"
          ]
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Pattern density in object space. Larger is finer."
        },
        "detail": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "distortion": {
          "type": "number",
          "minimum": 0
        },
        "stretch": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "Per-axis multiplier on the mapping, so a grain can run along one direction (wood) instead of being isotropic."
        },
        "bump": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Strength of the normal perturbation. 0 leaves the surface smooth."
        },
        "roughnessVariation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How far the pattern swings roughness around its authored value, which is what breaks a highlight up instead of letting it read as plastic."
        },
        "colorVariation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How strongly the pattern darkens the base colour."
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "shader"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "shader": {
          "type": "string",
          "enum": [
            "principled",
            "emission",
            "glass"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseColor": {
              "$ref": "#/$defs/unitColor"
            },
            "metallic": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ior": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            },
            "alpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "emissionColor": {
              "$ref": "#/$defs/unitColor"
            },
            "emissionStrength": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "coatWeight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "transmissionWeight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "anisotropic": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Cycles Principled specular anisotropy. 0 disables; positive values need an explicit material tangent."
            },
            "anisotropicRotation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Rotate the anisotropic tangent in turns: 0.25 is 90 degrees; 1 is one full turn. Nonzero values need an explicit tangent."
            }
          }
        },
        "texture": {
          "$ref": "#/$defs/proceduralTexture"
        },
        "images": {
          "$ref": "#/$defs/materialImages"
        },
        "tangent": {
          "$ref": "#/$defs/materialTangent"
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/vec3"
        },
        "rotationEuler": {
          "$ref": "#/$defs/vec3",
          "description": "Radians, XYZ Euler order, matching bpy's rotation_euler."
        },
        "scale": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape"
      ],
      "description": "Deterministic procedural geometry. Lathe revolves a radius/height profile; handled_cup constructs a closed cup with shared-boundary flared handle roots. Coupled parameter constraints are checked before generation and the discrete output is validated.",
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "cube",
            "uv_sphere",
            "cylinder",
            "cone",
            "plane",
            "torus",
            "rounded_box",
            "lathe",
            "curve",
            "handled_cup"
          ]
        },
        "size": {
          "$ref": "#/$defs/positiveNumber"
        },
        "radius": {
          "$ref": "#/$defs/positiveNumber"
        },
        "depth": {
          "$ref": "#/$defs/positiveNumber"
        },
        "segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 512
        },
        "ringCount": {
          "type": "integer",
          "minimum": 3,
          "maximum": 512
        },
        "majorRadius": {
          "$ref": "#/$defs/positiveNumber"
        },
        "minorRadius": {
          "$ref": "#/$defs/positiveNumber"
        },
        "bevel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "$ref": "#/$defs/positiveNumber"
            },
            "segments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          }
        },
        "profile": {
          "type": "array",
          "minItems": 2,
          "maxItems": 128,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "description": "Lathe boundary in ordered [radius, height] points, in scene units. Radius must be nonnegative. Do not repeat the first point to close it."
        },
        "closedProfile": {
          "type": "boolean",
          "description": "Join the final profile point to the first, for annular or hollow sections. Default false."
        },
        "capEnds": {
          "type": "boolean",
          "description": "Close open lathe rings or curve ends. Default true; closed paths and profiles need no caps."
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/vec3"
          },
          "description": "Ordered local-space points for a swept round section."
        },
        "pathClosed": {
          "type": "boolean",
          "description": "Connect the last path point to the first. Default false."
        },
        "pathInterpolation": {
          "type": "string",
          "enum": [
            "poly",
            "bezier"
          ],
          "description": "poly preserves straight segments; bezier uses automatic smooth handles. Default poly."
        },
        "curveResolution": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "bevelResolution": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "height": {
          "$ref": "#/$defs/positiveNumber"
        },
        "wallThickness": {
          "$ref": "#/$defs/positiveNumber"
        },
        "baseThickness": {
          "$ref": "#/$defs/positiveNumber"
        },
        "footRound": {
          "$ref": "#/$defs/positiveNumber"
        },
        "handleRadius": {
          "$ref": "#/$defs/positiveNumber"
        },
        "handleLower": {
          "$ref": "#/$defs/positiveNumber"
        },
        "handleUpper": {
          "$ref": "#/$defs/positiveNumber"
        },
        "rootRadius": {
          "$ref": "#/$defs/positiveNumber"
        },
        "rootLength": {
          "$ref": "#/$defs/positiveNumber"
        },
        "sectionSegments": {
          "type": "integer",
          "minimum": 32,
          "maximum": 96
        },
        "handleSegments": {
          "type": "integer",
          "minimum": 24,
          "maximum": 128
        },
        "rootSegments": {
          "type": "integer",
          "minimum": 8,
          "maximum": 48
        },
        "wallRows": {
          "type": "integer",
          "minimum": 16,
          "maximum": 64
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "asset-instance",
            "generator",
            "empty"
          ]
        },
        "assetId": {
          "type": "string",
          "description": "Required when type is asset-instance."
        },
        "armatureId": {
          "type": "string",
          "description": "The armature this entity is skinned to, named by `armatures[].id`. The compiler binds the mesh with Blender's own automatic weights, so the entity follows the bones with no weight table to write by hand. A name the scene does not declare is refused rather than ignored, because an entity that is silently unskinned renders as a static object while the file says it is rigged."
        },
        "rigidBody": {
          "$ref": "#/$defs/rigidBody",
          "description": "This entity takes part in physics (SPEC §20 M6, complex simulation). WHAT THIS SLICE DOES: rigid bodies — active ones fall and collide, passive ones are what they collide with, and the compile BAKES the result into the checkpoint so a render shows it. WHAT IT DOES NOT DO YET: cloth, soft bodies and fluids, which are the next slices."
        },
        "cloth": {
          "$ref": "#/$defs/cloth",
          "description": "This entity is simulated as FABRIC. A different field from `rigidBody` because it is a different mechanism rather than a different setting: a rigid body is a body type on the object, while cloth is a modifier that deforms the mesh. WHAT THIS SLICE DOES NOT DO YET: soft bodies and fluids, which are the next slices."
        },
        "softBody": {
          "$ref": "#/$defs/softBody",
          "description": "This entity is simulated as a SOFT BODY: it deforms and it remembers its shape, which is what separates it from cloth. A separate field because it is a separate modifier with separate settings; WHAT THIS DOES NOT DO YET: fluids, the last slice."
        },
        "fluid": {
          "$ref": "#/$defs/fluid",
          "description": "This entity takes part in a FLUID simulation (SPEC §20 M6, complex simulation). Unlike the other three mechanisms, a fluid needs more than one entity — a domain and something flowing into it — which is why the field carries a role."
        },
        "generator": {
          "$ref": "#/$defs/generator"
        },
        "materialId": {
          "type": "string",
          "description": "Material applied to this entity's generated mesh."
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "locked": {
          "type": "boolean",
          "description": "A locked entity may still be patched explicitly, but the orchestrator must not propose changes to it autonomously (SPEC §12)."
        },
        "visible": {
          "type": "boolean"
        },
        "modifiers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/modelModifier"
          },
          "description": "Ordered mesh operations, applied before animation and simulation. Boolean dependencies compile before their consumers. Each participating entity must contain exactly one mesh."
        },
        "materialBindings": {
          "$ref": "#/$defs/materialBindings",
          "description": "Asset mesh part overrides, preserving original slots and face indices. Part-wide overrides precede slot-specific overrides."
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "area",
            "point",
            "spot",
            "sun"
          ]
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "energy": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "color": {
          "$ref": "#/$defs/unitColor"
        },
        "size": {
          "$ref": "#/$defs/positiveNumber",
          "description": "area: light radius; point/spot: shadow soft size."
        },
        "spotSize": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.14159265358979
        },
        "spotBlend": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "angle": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.14159265358979
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "enum": [
            "active-camera",
            "three-quarter",
            "top",
            "detail"
          ],
          "description": "What this camera is FOR. A view plan assigns roles to cameras by name (active camera, 45-degree, top-down, subject close-up) and falls back to declaration order, so a role is what makes a multi-view plan reproducible rather than positional."
        },
        "lens": {
          "$ref": "#/$defs/positiveNumber"
        },
        "sensorWidth": {
          "$ref": "#/$defs/positiveNumber"
        },
        "clipping": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/positiveNumber"
          }
        },
        "transform": {
          "$ref": "#/$defs/transform",
          "description": "Camera position. When `targetEntityId` or `targetPoint` is present the rotation is DERIVED by aiming -Z at the target, so a hand-written rotationEuler is ignored (and is reported as a validation notice)."
        },
        "targetEntityId": {
          "type": "string"
        },
        "targetPoint": {
          "$ref": "#/$defs/vec3"
        },
        "fStop": {
          "$ref": "#/$defs/positiveNumber"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cameraId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cameraId": {
          "type": "string"
        },
        "frameRange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "animationKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "value"
      ],
      "properties": {
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "number"
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "constant",
            "linear",
            "bezier",
            "ease_in",
            "ease_out",
            "ease_in_out"
          ]
        }
      }
    },
    "animationTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetEntityId",
        "property",
        "keyframes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "targetKind": {
          "type": "string",
          "enum": [
            "entity",
            "camera",
            "material",
            "bone"
          ],
          "default": "entity",
          "description": "What `targetEntityId` names: an entity (default), a camera, a material, or AN ARMATURE whose bone this track drives (with `boneName`). Ids are unique per collection, so the kind is the only thing that says whether \"watch-dial\" means the mesh or the material — and `bone` is what made a rig able to move rather than merely exist."
        },
        "targetEntityId": {
          "type": "string",
          "description": "The id of the target named by `targetKind`. The field name says Entity because every track written before target kinds existed used it and revisions are immutable; renaming it would make r0001-r0023 unreadable. Resolution is against the collection `targetKind` names, which matters because ids are unique per collection, not globally."
        },
        "boneName": {
          "type": "string",
          "maxLength": 64,
          "description": "Required when targetKind is `bone`: the name of the bone inside the named armature. A name the armature does not have is refused — a track that silently animates nothing is a scene that claims to move and does not."
        },
        "property": {
          "type": "string",
          "enum": [
            "location.x",
            "location.y",
            "location.z",
            "rotationEuler.x",
            "rotationEuler.y",
            "rotationEuler.z",
            "scale.x",
            "scale.y",
            "scale.z",
            "emissionStrength",
            "roughness",
            "metallic",
            "ior",
            "alpha",
            "coatWeight",
            "transmissionWeight",
            "baseColor.r",
            "baseColor.g",
            "baseColor.b",
            "emissionColor.r",
            "emissionColor.g",
            "emissionColor.b",
            "anisotropic",
            "anisotropicRotation"
          ],
          "description": "The channel to animate. Transform channels apply to entities and cameras; material parameters apply to materials and use the same names `material.parameter.update` takes."
        },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/animationKeyframe"
          }
        }
      }
    },
    "renderProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "resolution"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "eevee",
            "cycles",
            "workbench"
          ]
        },
        "resolution": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 16,
            "maximum": 16384
          }
        },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "filmTransparent": {
          "type": "boolean"
        },
        "raytracing": {
          "type": "boolean",
          "description": "EEVEE only: enable the raytracing pipeline (screen-space GI, ambient occlusion and reflections). EEVEE defaults this OFF, which renders every surface lit only by direct light - objects lose their contact shadow and appear to float. Ignored by engines that have no such switch."
        },
        "colorManagement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "viewTransform": {
              "type": "string",
              "enum": [
                "Standard",
                "AgX",
                "Filmic",
                "False Color",
                "Raw"
              ]
            },
            "look": {
              "type": "string"
            },
            "exposure": {
              "type": "number",
              "minimum": -10,
              "maximum": 10
            }
          }
        },
        "maxSamplesBudget": {
          "type": "integer",
          "minimum": 1,
          "description": "Upper bound a render action may use. Guards the render-cost threshold of SPEC §15.4."
        }
      }
    },
    "renderProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview"
      ],
      "properties": {
        "preview": {
          "$ref": "#/$defs/renderProfile"
        },
        "final": {
          "$ref": "#/$defs/renderProfile"
        }
      }
    },
    "bone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "head",
        "tail"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The bone's name inside its armature. A parent names another bone by this, so it is the identity a rig is written in terms of."
        },
        "head": {
          "$ref": "#/$defs/vec3"
        },
        "tail": {
          "$ref": "#/$defs/vec3"
        },
        "parent": {
          "type": "string",
          "description": "The name of another bone in the SAME armature, or absent for a root. Bones are declared in any order; the compiler resolves the hierarchy, because requiring parents-first would make a rig's declaration depend on its storage order."
        }
      }
    },
    "armature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bones"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "bones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bone"
          },
          "description": "At least one bone, because an armature with none is a rig that cannot move anything and would silently do nothing."
        },
        "transform": {
          "$ref": "#/$defs/transform"
        }
      }
    },
    "rigidBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "active",
            "passive"
          ],
          "description": "`active` means physics moves it; `passive` means it moves nothing and everything collides with it — a floor is passive, which is why the two are one field rather than a boolean: a body that is not simulated and a body that is simulated are not the only two things a body can be."
        },
        "mass": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Kilograms, for an active body. Blender's own default applies when it is absent, and the default is stated rather than duplicated: a second copy of it here is the one that would go stale."
        },
        "friction": {
          "type": "number",
          "minimum": 0,
          "description": "Blender's own default applies when absent."
        }
      }
    },
    "cloth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pinTop": {
          "type": "boolean",
          "default": true,
          "description": "Hang the cloth from its top edge, which is what makes it drape rather than fall. The compiler builds the vertex group Blender needs from the geometry, because a group name in the file would be a reference to something no generator creates."
        },
        "mass": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Kilograms per square metre. Blender's own default applies when absent."
        },
        "stiffness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How much the fabric resists bending, 0 to 1. Blender's own default applies when absent."
        }
      }
    },
    "softBody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pinTop": {
          "type": "boolean",
          "default": false,
          "description": "Hold the top edge in place, so the body deforms around it rather than falling freely."
        },
        "goal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How strongly the body remembers its shape, 0 to 1. Blender's own default applies when absent, and that default is high — which is why a soft body falls while keeping its shape rather than collapsing, and why both of those are asserted."
        },
        "mass": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Kilograms. Blender's own default applies when absent."
        }
      }
    },
    "fluid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "domain",
            "inflow",
            "outflow"
          ],
          "description": "A fluid takes at least TWO entities: one DOMAIN, which is the volume the liquid lives in, and one or more INFLOW/OUTFLOW objects inside it. That is why this is a role rather than a flag — there is no such thing as a single entity that is a fluid."
        },
        "domainType": {
          "type": "string",
          "enum": [
            "liquid",
            "gas"
          ],
          "default": "liquid",
          "description": "On a domain: what fills it. THE DEFAULT IS `liquid` AND THAT IS DELIBERATE: Blender's own default is `gas`, and MEASURED, a LIQUID inflow into a GAS domain produces nothing at all — the bake reports success, both caches report baked, and the domain's evaluated mesh is its own cube. A default that produces nothing while every signal says it worked is the exact trap this product exists around."
        },
        "resolution": {
          "type": "integer",
          "minimum": 8,
          "maximum": 256,
          "description": "On a domain: the simulation's grid resolution. It is the cost knob — the bake's time and memory grow with it — so it is stated rather than left to a default nobody can see."
        },
        "flowType": {
          "type": "string",
          "enum": [
            "liquid",
            "smoke",
            "fire",
            "both"
          ],
          "default": "liquid",
          "description": "On an inflow or outflow: what it emits."
        }
      }
    },
    "modelModifier": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "thickness"
          ],
          "properties": {
            "type": {
              "const": "solidify"
            },
            "thickness": {
              "type": "number"
            },
            "offset": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "axis"
          ],
          "properties": {
            "type": {
              "const": "mirror"
            },
            "axis": {
              "type": "string",
              "enum": [
                "x",
                "y",
                "z"
              ]
            },
            "merge": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "count",
            "offset"
          ],
          "properties": {
            "type": {
              "const": "array"
            },
            "count": {
              "type": "integer",
              "minimum": 2,
              "maximum": 64
            },
            "offset": {
              "$ref": "#/$defs/vec3"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "operation",
            "targetEntityId"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "operation": {
              "type": "string",
              "enum": [
                "union",
                "difference",
                "intersect"
              ]
            },
            "targetEntityId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "width"
          ],
          "properties": {
            "type": {
              "const": "bevel"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "segments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "angle": {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            },
            "miterInner": {
              "type": "string",
              "enum": [
                "arc",
                "sharp"
              ],
              "default": "arc",
              "description": "Inner corner join for this bevel modifier. Omitted values preserve the existing arc behavior."
            }
          }
        }
      ]
    },
    "imageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "scale": {
          "$ref": "#/$defs/vec3"
        },
        "offset": {
          "$ref": "#/$defs/vec3"
        },
        "uvMap": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "channel": {
          "type": "string",
          "enum": [
            "r",
            "g",
            "b",
            "a"
          ]
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "materialImages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseColor": {
          "$ref": "#/$defs/imageBinding"
        },
        "roughness": {
          "$ref": "#/$defs/imageBinding"
        },
        "metallic": {
          "$ref": "#/$defs/imageBinding"
        },
        "normal": {
          "$ref": "#/$defs/imageBinding"
        },
        "alpha": {
          "$ref": "#/$defs/imageBinding"
        },
        "emissionColor": {
          "$ref": "#/$defs/imageBinding"
        }
      }
    },
    "materialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partId",
        "materialId"
      ],
      "properties": {
        "partId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/",
          "description": "Exact source path returned in assetParts; JSON Pointer escaped segments."
        },
        "slotIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Original material slot index. Omit to replace every slot of this mesh part."
        },
        "materialId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "materialBindings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/materialBinding"
      }
    },
    "materialTangent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "uvMap"
          ],
          "properties": {
            "mode": {
              "const": "uv"
            },
            "uvMap": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            }
          },
          "description": "Use the tangent along the named UV map U direction. The map must exist on every mesh face using this material."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "axis"
          ],
          "properties": {
            "mode": {
              "const": "radial"
            },
            "axis": {
              "enum": [
                "x",
                "y",
                "z"
              ]
            }
          },
          "description": "Blender cylindrical-projection tangent around the selected object-local axis; no UV map required."
        }
      ]
    },
    "referenceImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assetId",
        "sha256",
        "label",
        "purposes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "geometry",
              "materials",
              "lighting",
              "goalFit"
            ]
          },
          "description": "Distinct review dimensions this reference informs; duplicate purposes are rejected semantically."
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "referenceImages": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/referenceImage"
      },
      "description": "Visual review references only. Each id is unique and points to a declared, hash-pinned PNG/JPEG project asset; this does not apply an object texture or environment map."
    }
  }
}
