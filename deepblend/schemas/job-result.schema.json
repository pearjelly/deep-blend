{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepblend.local/schemas/job-result.schema.json",
  "title": "DeepBlend JobResult v1",
  "description": "The durable record of one Blender batch attempt (SPEC §9.3 result.json, §10.2). M1 writes one job record per apply/render attempt beneath `<project>/jobs/`; M3 promotes this to the persistent, restart-recovered Job Store, so the on-disk shape is fixed here now.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "projectId", "action", "status", "startedAt"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "deepblend.job/v1" },
    "jobId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "revision": {
      "type": ["string", "null"],
      "description": "The revision this job produced (apply) or read (preview/validate). Null when the job failed before a revision existed."
    },
    "action": {
      "type": "string",
      "enum": ["compile_scene", "render_preview", "apply_scene_patch", "validate_scene", "restore_revision"]
    },
    "status": { "type": "string", "enum": ["running", "succeeded", "failed"] },
    "errorCode": {
      "type": ["string", "null"],
      "description": "A BlenderErrorCode value. Present only when status is failed."
    },
    "message": { "type": ["string", "null"] },
    "startedAt": { "type": "string", "description": "ISO-8601 UTC." },
    "finishedAt": { "type": ["string", "null"], "description": "ISO-8601 UTC." },
    "durationMs": { "type": ["integer", "null"], "minimum": 0 },
    "idempotencyKey": { "type": ["string", "null"] },
    "baseRevision": { "type": ["string", "null"] },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "blender": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "Runtime identity recorded for reproducibility: version, engine, device, protocol version (SPEC §9.5)."
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "bytes"],
      "properties": {
        "kind": { "type": "string", "enum": ["blend", "preview", "validation", "scene-spec", "log"] },
        "path": {
          "type": "string",
          "description": "Path relative to the PROJECT root, never absolute — a stored manifest must survive the workspace being moved."
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "mime": { "type": ["string", "null"] }
      }
    }
  }
}
