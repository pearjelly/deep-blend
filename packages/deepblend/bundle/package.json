{
  "name": "@deepblend/dsh-blender-bundle",
  "version": "0.18.0",
  "description": "Create Blender product scenes in DSH with editable recipes, model imports, previews and PNG/MP4 delivery; includes workbench and agent configuration.",
  "main": "lib/index.js",
  "bin": {
    "deepblend-doctor": "lib/doctor-cli.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    },
    "./provider-local": {
      "default": "./lib/planes/provider-local.js"
    },
    "./host": {
      "default": "./lib/planes/host.js"
    },
    "./preset": {
      "default": "./lib/planes/preset.js"
    },
    "./tool": {
      "default": "./lib/planes/tool.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshots.json",
    "README.zh.md",
    "assets",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepblend/dsh-blender-contracts": "github:pearjelly/deep-blend#path:/packages/deepblend/contracts",
    "@deepblend/dsh-blender-host": "github:pearjelly/deep-blend#path:/packages/deepblend/host",
    "@deepblend/dsh-blender-preset": "github:pearjelly/deep-blend#path:/packages/deepblend/preset",
    "@deepblend/dsh-blender-provider-local": "github:pearjelly/deep-blend#path:/packages/deepblend/provider-local",
    "@deepblend/dsh-blender-tool": "github:pearjelly/deep-blend#path:/packages/deepblend/tool",
    "@deepblend/dsh-blender-ui": "github:pearjelly/deep-blend#path:/packages/deepblend/ui"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pearjelly/deep-blend.git",
    "directory": "packages/deepblend/bundle"
  },
  "homepage": "https://github.com/pearjelly/deep-blend#quick-start",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "blender",
    "3d",
    "product-visualization",
    "rendering",
    "agent"
  ],
  "bugs": {
    "url": "https://github.com/pearjelly/deep-blend/issues"
  },
  "engines": {
    "node": ">=22.23.3",
    "dsh": "0.1.5-rc.2 || 0.2.1-rc.1"
  }
}
