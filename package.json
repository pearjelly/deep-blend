{
  "name": "deepblend-studio",
  "version": "0.2.4",
  "private": true,
  "description": "DeepBlend Studio — a Blender 3D animation agent workbench built as a DSH Host Bundle plus an Agent Preset. SceneSpec is the source of truth, .blend is a compiled artifact.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "blender",
    "bpy",
    "3d-animation",
    "agent",
    "scene-spec"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node deepblend/tools/link-workspace.mjs",
    "setup:check": "node deepblend/tools/link-workspace.mjs --check",
    "blender:install": "node deepblend/tools/install-blender.mjs",
    "blender:check": "node deepblend/tools/install-blender.mjs --check",
    "plugin:install": "node deepblend/tools/install-plugin.mjs",
    "plugin:check": "node deepblend/tools/install-plugin.mjs --check",
    "plugin:uninstall": "node deepblend/tools/install-plugin.mjs --uninstall",
    "presets:install": "node deepblend/tools/install-presets.mjs",
    "presets:check": "node deepblend/tools/install-presets.mjs --check",
    "presets:uninstall": "node deepblend/tools/install-presets.mjs --uninstall",
    "presets:sync": "node deepblend/tools/sync-plugin-presets.mjs",
    "presets:sync:check": "node deepblend/tools/sync-plugin-presets.mjs --check",
    "listing:project": "node deepblend/tools/project-listing-entry.mjs",
    "listing:check": "node deepblend/tools/project-listing-entry.mjs --check-remote",
    "version:check": "node deepblend/tools/release-version.mjs --check",
    "version:sync": "node deepblend/tools/release-version.mjs --sync",
    "release:freshness": "node deepblend/tools/release-version.mjs --stale",
    "release:check": "node deepblend/tools/build-release-tarball.mjs --check",
    "release:tarball": "node deepblend/tools/build-release-tarball.mjs",
    "publish:check": "node deepblend/tools/publish-packages.mjs --check",
    "publish:dry-run": "node deepblend/tools/publish-packages.mjs --dry-run",
    "publish:packages": "node deepblend/tools/publish-packages.mjs",
    "verify:clone": "node deepblend/tools/verify-clean-clone.mjs",
    "test": "node deepblend/tests/run.mjs",
    "test:acceptance": "bash deepblend/tests/run-all.sh",
    "docs:images": "node deepblend/tools/capture-docs-images.mjs",
    "release:parity": "node deepblend/tools/release-route-parity.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pearjelly/deep-blend.git"
  },
  "homepage": "https://github.com/pearjelly/deep-blend#readme",
  "bugs": {
    "url": "https://github.com/pearjelly/deep-blend/issues"
  }
}
