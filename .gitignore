# Dependency links into the DSH installation (absolute symlinks, not content).
node_modules/

# The Blender runtime installed into the workspace during M0 setup (~907 MB).
# Reproduce with the documented download instead of committing it; see
# deepblend/docs/dsh-baseline.md §5.
.tools/

# DeepBlend runtime state, never source:
#   .deepblend/tmp/       per-invocation Blender working directories
#   .deepblend/projects/  the Project + Revision Store (M1). This is where real
#                         projects live, including the demo project. It is
#                         deliberately NOT committed: it is generated state, and
#                         everything that makes it reproducible IS committed —
#                         the fixture SceneSpec plus the two tools that build the
#                         project from it:
#                           deepblend/tools/create-demo-project.mjs   -> r0001-r0002
#                           deepblend/tools/apply-brief-content.mjs   -> r0019-r0023
#                         The second one exists because the generator alone did
#                         NOT make the store reproducible: the revisions that
#                         express SPEC.md:150 lived only in one uncommitted store.
.deepblend/

# OS noise
.DS_Store

# Python bytecode
__pycache__/
*.pyc
