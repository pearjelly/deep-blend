# Dependency links into the DSH installation (absolute symlinks, not content).
# Twelve of them, derived from what the source imports. Reproduce with:
#   npm run setup          (node deepblend/tools/link-workspace.mjs)
#   npm run setup:check    (report drift, change nothing)
# Ignoring this directory is right; having NO step that creates it was not, and
# on 2026-09-14 it cost the repository all sixteen of its contract suites at
# once — no assertion ran, they died on ERR_MODULE_NOT_FOUND. The step and the
# test that keeps it true (tests/contract/workspace-links.test.mjs) are M5.
node_modules/

# The Blender runtime installed into the workspace (~1.4 GB extracted, plus the
# 346 MB image under downloads/). Reproduce with:
#   npm run blender:install   (node deepblend/tools/install-blender.mjs)
#   npm run blender:check
# The pin — version, URL, byte size, sha256 — is committed in
# deepblend/tools/blender-release.json; only the 1.4 GB is not.
.tools/

# DeepBlend runtime state, never source:
#   .deepblend/tmp/       per-invocation Blender working directories
#   .deepblend/projects/  the Project + Revision Store (M1). This is where real
#                         projects live, including the demo project. It is
#                         deliberately NOT committed: it is generated state, and
#                         everything that makes it reproducible IS committed —
#                         the fixture SceneSpec plus the two tools that build the
#                         project from it:
#                           deepblend/tools/create-demo-project.mjs   -> r0001-r0002
#                           deepblend/tools/apply-brief-content.mjs   -> r0019-r0023
#                         The second one exists because the generator alone did
#                         NOT make the store reproducible: the revisions that
#                         express SPEC.md:150 lived only in one uncommitted store.
.deepblend/

# OS noise
.DS_Store

# Python bytecode
__pycache__/
*.pyc
